generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  name             String?
  email            String?   @unique
  password         String?
  confirm_password String?
  isAdmin          Boolean   @default(false)
  isBanned         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  orders                  Order[]              @relation("UserOrders")
  favorites               Favorite[]           @relation("UserFavorites")
  auditLogs               AuditLog[]           @relation("AdminAuditLogs")
  stockMovements          StockMovement[]      @relation("AdminStockMovements")
  assignedCoupons         Coupon[]             @relation("CouponUser")
  foodIssueReports        FoodIssueReport[]    @relation("UserFoodIssueReports")
  announcements           Announcement[]       @relation("AnnouncementAuthor")
  notifications           Notification[]       @relation("UserNotifications")
  currencySettingsUpdates RestaurantSettings[] @relation("CurrencySettingsUpdater")

  @@index([deletedAt])
}

model FoodType {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  foods   Food[]   @relation("TypeFoods")
  coupons Coupon[] @relation("CategoryCoupons")
}

model Food {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  ingredients         String[] @default([])
  optionalIngredients Json     @default("[]")
  extraCheesePrice    Decimal  @default(1.5) @db.Decimal(14, 2)
  qty                 Int
  minStock            Int      @default(5)
  price               Decimal  @db.Decimal(14, 2)
  image               String?
  createdAt           DateTime @default(now())

  typeId String
  type   FoodType @relation("TypeFoods", fields: [typeId], references: [id], onDelete: Cascade)

  orderItems     OrderItem[]     @relation("FoodOrderItems")
  favorites      Favorite[]      @relation("FoodFavorites")
  stockMovements StockMovement[]
}

model Order {
  id                  String    @id @default(uuid())
  orderNumber         String?   @unique
  checkoutRequestId   String?
  checkoutRequestHash String?
  userId              String
  total               Decimal   @db.Decimal(14, 2)
  subtotal            Decimal   @default(0) @db.Decimal(14, 2)
  deliveryFee         Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount      Decimal   @default(0) @db.Decimal(14, 2)
  status              String    @default("pending")
  stockReturned       Boolean   @default(false)
  customerName        String?
  customerPhone       String?
  fulfillmentType     String    @default("delivery")
  paymentMethod       String?
  paymentCode         String?
  paymentStatus       String    @default("pending")
  refundedAmount      Decimal   @default(0) @db.Decimal(14, 2)
  exchangeRateUsed    Decimal?  @db.Decimal(18, 4)
  customerAddress     String?
  mapLocation         String?
  orderNotes          String?
  estimatedReadyAt    DateTime?
  deliveryZoneId      String?
  couponId            String?
  couponCode          String?
  createdAt           DateTime  @default(now())
  adminArchivedAt     DateTime?

  user           User              @relation("UserOrders", fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]       @relation("OrderItems")
  deliveryZone   DeliveryZone?     @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  coupon         Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  issueReports   FoodIssueReport[] @relation("OrderFoodIssueReports")

  @@unique([userId, checkoutRequestId])
  @@index([paymentStatus])
  @@index([adminArchivedAt])
}

model OrderItem {
  id                 Int               @id @default(autoincrement())
  orderId            String
  order              Order             @relation("OrderItems", fields: [orderId], references: [id], onDelete: Restrict)
  foodId             String
  food               Food              @relation("FoodOrderItems", fields: [foodId], references: [id], onDelete: Restrict)
  foodName           String            @default("")
  quantity           Int
  price              Decimal           @db.Decimal(14, 2)
  extraCheese        Boolean           @default(false)
  removedIngredients String[]          @default([])
  addedIngredients   Json              @default("[]")
  customizationNote  String?
  issueReports       FoodIssueReport[] @relation("OrderItemFoodIssueReports")
}

model FoodIssueReport {
  id           String    @id @default(uuid())
  orderId      String
  orderItemId  Int
  userId       String
  reason       String
  details      String
  quantity     Int       @default(1)
  status       String    @default("pending")
  refundAmount Decimal   @default(0) @db.Decimal(14, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?

  order     Order     @relation("OrderFoodIssueReports", fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation("OrderItemFoodIssueReports", fields: [orderItemId], references: [id], onDelete: Restrict)
  user      User      @relation("UserFoodIssueReports", fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([orderId])
  @@index([orderItemId])
  @@index([userId])
}

model Favorite {
  userId    String
  foodId    String
  createdAt DateTime @default(now())

  user User @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation("FoodFavorites", fields: [foodId], references: [id], onDelete: Cascade)

  @@id([userId, foodId])
  @@index([foodId])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  adminEmail String
  action     String
  entityType String
  entityId   String?
  changes    Json?
  createdAt  DateTime @default(now())

  admin User? @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId])
  @@index([entityType])
}

model DeliveryZone {
  id               String   @id @default(uuid())
  name             String   @unique
  description      String   @default("")
  deliveryFee      Decimal  @db.Decimal(14, 2)
  minimumOrder     Decimal  @db.Decimal(14, 2)
  estimatedMinutes Int
  isAvailable      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders Order[]
}

model RestaurantHours {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int      @unique
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model RestaurantSettings {
  id           Int      @id @default(1)
  usdToLbpRate Decimal? @db.Decimal(18, 4)
  updatedAt    DateTime @updatedAt
  updatedById  String?

  updatedBy User? @relation("CurrencySettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model Coupon {
  id           String    @id @default(uuid())
  code         String    @unique
  description  String    @default("")
  discountType String
  value        Decimal   @db.Decimal(14, 4)
  minimumOrder Decimal   @default(0) @db.Decimal(14, 2)
  expiresAt    DateTime?
  usageLimit   Int?
  usedCount    Int       @default(0)
  userId       String?
  categoryId   String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User?     @relation("CouponUser", fields: [userId], references: [id], onDelete: SetNull)
  category FoodType? @relation("CategoryCoupons", fields: [categoryId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([userId])
  @@index([categoryId])
}

model StockMovement {
  id          String   @id @default(uuid())
  foodId      String
  adminId     String?
  orderId     String?
  change      Int
  previousQty Int
  newQty      Int
  reason      String
  createdAt   DateTime @default(now())

  food  Food   @relation(fields: [foodId], references: [id], onDelete: Restrict)
  admin User?  @relation("AdminStockMovements", fields: [adminId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([foodId, createdAt])
  @@index([adminId])
  @@index([orderId])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  message     String
  published   Boolean   @default(false)
  eventDate   DateTime?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy     User?          @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  notifications Notification[] @relation("AnnouncementNotifications")

  @@index([published, createdAt])
  @@index([eventDate])
  @@index([expiresAt])
  @@index([createdById])
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  announcementId String
  title          String
  message        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  user         User         @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation("AnnouncementNotifications", fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId, read, createdAt])
  @@index([announcementId])
}
