{
  "name": "restaurant-management-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "build": "next build --turbopack",
    "lint": "eslint .",
    "security:audit-passwords": "tsx scripts/migrate-password-hashes.ts",
    "security:migrate-passwords": "tsx scripts/migrate-password-hashes.ts --apply",
    "smoke": "node scripts/browser-health-check.mjs",
    "test:rate-limit": "tsx scripts/test-upstash-rate-limit.ts",
    "test:rate-limit:required": "tsx scripts/test-upstash-rate-limit.ts --require-configured",
    "test:checkout": "tsx --conditions=react-server scripts/checkout-concurrency-test.ts",
    "test:authorization": "tsx --conditions=react-server scripts/authorization-boundary-test.ts",
    "test:data-integrity": "tsx --conditions=react-server scripts/data-integrity-test.ts",
    "test:financial": "tsx --conditions=react-server scripts/financial-correctness-test.ts",
    "test:password-recovery": "tsx --conditions=react-server scripts/password-recovery-test.ts",
    "test:customer-auth": "tsx --conditions=react-server scripts/customer-auth-regression-test.ts",
    "test:business-config": "tsx --conditions=react-server scripts/business-configuration-test.ts",
    "check:launch-config": "tsx --conditions=react-server scripts/check-launch-config.ts",
    "check:launch-config:required": "tsx --conditions=react-server scripts/check-launch-config.ts --require-configured",
    "test:admin-browser": "tsx --conditions=react-server scripts/admin-browser-health-test.ts",
    "test:admin-login-browser": "tsx --conditions=react-server scripts/admin-login-browser-test.ts",
    "test:customer-browser": "tsx --conditions=react-server scripts/customer-browser-regression-test.ts",
    "test:database-outage": "tsx scripts/database-outage-probe.ts",
    "test": "tsx --test src/**/*.test.ts",
    "verify": "node scripts/verify-release.mjs",
    "licenses:report": "node scripts/dependency-license-report.mjs",
    "package:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1",
    "start": "next start"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.71.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/blob": "^2.8.0",
    "bcrypt": "^6.0.0",
    "i18next": "^26.4.0",
    "next": "^15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.12",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.25"
  }
}
